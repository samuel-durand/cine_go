# Copiez ce fichier en server/.env et adaptez les valeurs.
PORT=5000
FLASK_ENV=development

# --- MySQL (ou DATABASE_URL=mysql+pymysql://user:pass@host:3306/cinego) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cinego

# --- Auth ---
JWT_SECRET=changez-moi
JWT_EXPIRE_DAYS=7

# --- CORS (obligatoire en production) ---
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_CURRENCY=eur

# --- E-mails : gmail | smtp | ethereal (vide = e-mails écrits dans server/instance/outbox/) ---
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_FROM=
ADMIN_EMAIL=
